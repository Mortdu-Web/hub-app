# Port d'écoute de hub-app (dans le conteneur et sur l'hôte)
PORT=25XXX
# Auth, vu depuis le conteneur hub-app (réseau Docker "web") :
# nom du conteneur + PORT d'auth + préfixe /auth
AUTH_INTERNAL_URL=http://auth:25000/auth
# Auth, vu depuis le navigateur de l'utilisateur
AUTH_PUBLIC_URL=https://mon-domaine.fr/auth
# URL publique de hub-app, sans slash final (sert au retour après déconnexion)
PUBLIC_URL=https://mon-domaine.fr/